  "thesis": {
    "stance": "HOLD",
    "supports": [
      { "text": "Market leader in Indian IT services with deep, sticky enterprise relationships and a large, diversified deal pipeline.", "source": "Annual Report FY25", "url": "https://www.tcs.com/investor-relations", "source_id": "S2" },
      { "text": "Best-in-class returns (ROCE ~64%, ROE ~52%) and an asset-light, net-cash balance sheet.", "source": "Screener", "url": "https://www.screener.in/company/TCS/consolidated/", "source_id": "S1" },
      { "text": "Strong free cash flow conversion funds a consistent dividend plus periodic buybacks.", "source": "Annual Report FY25", "url": "https://www.tcs.com/investor-relations", "source_id": "S2" },
      { "text": "Healthy large-deal total contract value signed in FY25 supports forward revenue visibility.", "source": "Q4 FY25 Earnings Concall", "url": "https://www.tcs.com/investor-relations", "source_id": "S4" }
    ],
    "counters": [
      { "text": "Discretionary technology spend remains soft, pressuring near-term revenue growth.", "source": "Q4 FY25 Earnings Concall", "url": "https://www.tcs.com/investor-relations", "source_id": "S4" },
      { "text": "Revenue growth has decelerated toward high-single-digits from mid-teens.", "source": "Screener", "url": "https://www.screener.in/company/TCS/consolidated/", "source_id": "S1" },
      { "text": "Wage inflation and attrition can compress margins if pricing doesn't keep pace.", "source": "Business news", "url": "https://www.business-standard.com/", "source_id": "S8" },
      { "text": "Valuation at ~29x earnings is rich relative to the current growth rate.", "source": "Screener", "url": "https://www.screener.in/company/TCS/consolidated/", "source_id": "S1" }
    ],
